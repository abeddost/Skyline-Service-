---
import '@fontsource-variable/saira/wght.css';
import '@fontsource-variable/manrope/wght.css';
import '../styles/global.css';
import displayFontUrl from '@fontsource-variable/saira/files/saira-latin-wght-normal.woff2?url';
import bodyFontUrl from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import { business } from '../config';
import { businessSchema, breadcrumbSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  crumbs?: { name: string; href: string }[];
  schema?: object[];
  ogImage?: string;
}
const { title, description, noindex = false, crumbs, schema = [], ogImage = '/og-default.jpg' } = Astro.props;

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/').replace(/(.)\/$/, '$1');
const canonical = new URL(path, Astro.site).toString();
const og = new URL(ogImage, Astro.site).toString();
const jsonld = [businessSchema(Astro.site), ...(crumbs ? [breadcrumbSchema(crumbs, Astro.site)] : []), ...schema];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0B0C0E" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={displayFontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFontUrl} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={business.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="format-detection" content="telephone=no" />
    <script is:inline>
      document.documentElement.classList.add('js');
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('reduce');
    </script>
    {jsonld.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#inhalt">Zum Inhalt springen</a>
    <Header />
    <main id="inhalt">
      <slot />
    </main>
    <Footer />
    <StickyBar />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
