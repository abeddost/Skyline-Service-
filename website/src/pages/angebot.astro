---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Configurator from '../components/Configurator.astro';
import Icon from '../components/Icon.astro';
import { business, whatsappLink, mailLink } from '../config';

const crumbs = [
  { name: 'Startseite', href: '/' },
  { name: 'Angebot anfragen', href: '/angebot' },
];
---

<Base
  title="Angebot anfragen – Skyline Service Frankfurt"
  description="Unverbindliches Angebot für Reinigung, Umzug oder Entrümpelung in Frankfurt in 3 Schritten zusammenstellen und per WhatsApp senden. Jetzt anfragen."
  crumbs={crumbs}
>
  <PageHero title="Unverbindliches Angebot in 3 Schritten" eyebrow="Angebots-Konfigurator" crumbs={crumbs} cta={false}>
    <p>Leistung wählen, Details ergänzen, per WhatsApp senden. Sie erhalten ein Festpreisangebot.</p>
  </PageHero>

  <section class="section section--flush" id="angebot">
    <div class="container">
      <Configurator />
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">Lieber direkt?</p>
        <h2>Direkt per WhatsApp, Telefon oder E-Mail anfragen</h2>
      </div>
      <div class="grid grid--3">
        <div class="card contact-card">
          <Icon name="whatsapp" size={26} ring />
          <h3>WhatsApp</h3>
          <p>Schreiben Sie uns und hängen Sie gleich Fotos an.</p>
          <a class="btn btn--wa" href={whatsappLink()} target="_blank" rel="noopener" data-track="click_whatsapp">Chat öffnen</a>
        </div>
        <div class="card contact-card">
          <Icon name="phone" size={26} ring />
          <h3>Telefon</h3>
          <p class="contact-card__value">{business.phoneDisplay}</p>
          <a class="btn btn--outline" href={business.phoneHref} data-track="click_call">Jetzt anrufen</a>
        </div>
        <div class="card contact-card">
          <Icon name="mail" size={26} ring />
          <h3>E-Mail</h3>
          <p class="contact-card__value">{business.email}</p>
          <a class="btn btn--outline" href={mailLink}>E-Mail schreiben</a>
        </div>
      </div>
    </div>
  </section>
</Base>
