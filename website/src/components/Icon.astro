---
// Line icons on a 24px grid, drawn to match the flyer style.
interface Props {
  name: string;
  size?: number;
  ring?: boolean;
  class?: string;
}
const { name, size = 24, ring = false, class: cls = '' } = Astro.props;

const paths: Record<string, string> = {
  building:
    '<path d="M4 21V7l6-3v17"/><path d="M10 9l10 3v9"/><path d="M2 21h20"/><path d="M7 9v.01M7 12v.01M7 15v.01M7 18v.01M14 14v.01M17 15v.01M14 17.5v.01M17 18.5v.01"/>',
  chair:
    '<path d="M8 3h8a1 1 0 011 1v7H7V4a1 1 0 011-1z"/><path d="M5 11h14v3H5z"/><path d="M12 14v4"/><path d="M12 18l-5 2.5M12 18l5 2.5M12 18v3"/>',
  stairs: '<path d="M3 20h4v-4h4v-4h4V8h4V4h2"/><path d="M3 20h18"/>',
  truck:
    '<path d="M2 6h11v10H2z"/><path d="M13 9h4l4 4v3h-8z"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>',
  box: '<path d="M3 8l9-5 9 5v8l-9 5-9-5z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/>',
  broom:
    '<path d="M15 3l-5.5 8"/><path d="M6 11h8l1.5 9h-11z"/><path d="M8 15v5M11 15v5"/><path d="M19.5 4v4M17.5 6h4"/>',
  shield: '<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>',
  diamond: '<path d="M6 4h12l3 5-9 11L3 9z"/><path d="M3 9h18"/><path d="M9 4L7.5 9 12 20l4.5-11L15 4"/>',
  leaf: '<path d="M5 19C5 10 10 5 20 5c0 10-5 15-14 14"/><path d="M4 20c3-5 6-8 11-10"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>',
  phone:
    '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z"/>',
  whatsapp:
    '<path d="M3.5 20.5l1.3-4.7A8.5 8.5 0 1112 20.5a8.5 8.5 0 01-4-1z"/><path d="M9 8.2c-.2 2.8 2.6 6 6 6.6l1.1-1.4-2-1.1-.9.8c-1-.500-1.8-1.3-2.3-2.3l.8-1-1.1-2z"/>',
  mail: '<path d="M3 6h18v12H3z"/><path d="M3 7l9 6 9-6"/>',
  pin: '<path d="M12 21s7-6.2 7-11.5a7 7 0 10-14 0C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
  check: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
  arrow: '<path d="M5 12h14"/><path d="M13 6l6 6-6 6"/>',
  chevron: '<path d="M6 9l6 6 6-6"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
  home: '<path d="M4 11l8-7 8 7"/><path d="M6 10v10h12V10"/><path d="M10 20v-5h4v5"/>',
  briefcase: '<path d="M3 8h18v11H3z"/><path d="M9 8V5h6v3"/><path d="M3 13h18"/>',
  keys: '<circle cx="8" cy="8" r="4"/><path d="M11 11l9 9"/><path d="M16 16l2.5-2.5M18.5 18.5L21 16"/>',
  sparkle: '<path d="M12 3l1.8 7.2L21 12l-7.2 1.8L12 21l-1.8-7.2L3 12l7.2-1.8z"/>',
};
const body = paths[name] ?? paths.sparkle;
---

<span class:list={['icon', ring && 'icon--ring', cls]} aria-hidden="true">
  <svg
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
    set:html={body}
  />
</span>
