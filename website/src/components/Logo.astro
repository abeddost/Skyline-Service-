---
// Logo: skyline behind a roof line with a four-point sparkle.
// The icon is inline SVG; the wordmark is live text in the display font:
// "Mainblick" with "Reinigung & Gebäudeservice" underneath.
import { business } from '../config';
interface Props {
  id?: string;
  size?: number;
  wordmark?: boolean;
}
const { id = 'logo', size = 40, wordmark = true } = Astro.props;
---

<span class="logo">
  <svg class="logo__icon" width={size} height={size} viewBox="0 0 64 64" role="img" aria-label={`${business.shortName} Logo`}>
    <defs>
      <linearGradient id={`${id}-g`} x1="8" y1="6" x2="56" y2="58" gradientUnits="userSpaceOnUse">
        <stop offset="0" style="stop-color:var(--accent-light)"></stop>
        <stop offset=".5" style="stop-color:var(--accent)"></stop>
        <stop offset="1" style="stop-color:var(--accent-dark)"></stop>
      </linearGradient>
      <mask id={`${id}-m`} maskUnits="userSpaceOnUse" x="0" y="0" width="64" height="64">
        <rect width="64" height="64" fill="#fff"></rect>
        <path d="M5 53 32 35l27 18" fill="none" stroke="#000" stroke-width="9" stroke-linejoin="round" stroke-linecap="round"
        ></path>
        <path d="M5 53 32 35l27 18v11H5z" fill="#000"></path>
      </mask>
    </defs>
    <g fill={`url(#${id}-g)`} mask={`url(#${id}-m)`}>
      <rect x="10" y="30" width="7" height="26" rx="1.2"></rect>
      <rect x="19.5" y="19" width="7" height="37" rx="1.2"></rect>
      <path d="M29 56V13l3.5-5 3.5 5v43z"></path>
      <rect x="38.5" y="23" width="7" height="33" rx="1.2"></rect>
      <rect x="48" y="33" width="6.5" height="23" rx="1.2"></rect>
    </g>
    <path
      d="M5 53 32 35l27 18"
      fill="none"
      stroke={`url(#${id}-g)`}
      stroke-width="3"
      stroke-linejoin="round"
      stroke-linecap="round"></path>
    <path d="M52 5l1.7 4.8 4.8 1.7-4.8 1.7L52 18l-1.7-4.8-4.8-1.7 4.8-1.7z" fill={`url(#${id}-g)`}></path>
  </svg>
  {
    wordmark && (
      <span class="logo__text">
        <span class="logo__name">{business.shortName}</span>
        <span class="logo__tag">{business.descriptor}</span>
      </span>
    )
  }
</span>
