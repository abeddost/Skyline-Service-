---
// Homepage hero. It fills the screen and stays pinned while the visitor
// scrolls: the office in the background goes from untidy to clean
// (components/HeroMedia.astro, scripts/hero-scroll.ts).
import Icon from './Icon.astro';
import HeroMedia from './HeroMedia.astro';
import HeroInfo from './HeroInfo.astro';
import { business } from '../config';
---

<section class="hero hero-scroll" data-hero-scroll>
  <div class="hero__sticky">
    <HeroMedia video="buero" alt="Büro mit Blick auf die Frankfurter Skyline, das vom ungepflegten in einen sauberen Zustand wechselt" />
    <div class="container">
      <div class="hero__content">
        <p class="eyebrow">Skyline Service · Frankfurt</p>
        <h1>Reinigung, Umzug &amp; <span class="accent">Entrümpelung</span> in Frankfurt</h1>
        <p class="hero__sub">
          Für Privat- und Gewerbekunden in Frankfurt &amp; Umgebung – zuverlässig, pünktlich und mit umweltfreundlichen
          Reinigungsmitteln.
        </p>
        <div class="btn-row hero__actions">
          <a class="btn btn--primary" href="#angebot">Unverbindliches Angebot</a>
          <a class="btn btn--outline" href={business.phoneHref} data-track="click_call">
            <Icon name="phone" size={18} />
            {business.phoneDisplay} anrufen
          </a>
        </div>
        <HeroInfo />
      </div>
    </div>
    <p class="hero__hint" aria-hidden="true">Scrollen</p>
    <div class="hero__progress" aria-hidden="true"><span></span></div>
  </div>
</section>
